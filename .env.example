# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Public link shown in the footer of every post. Defaults to https://t.me/<TELEGRAM_CHANNEL_ID>
# if TELEGRAM_CHANNEL_ID is an @username. Set explicitly if the channel ID is numeric or private
# (e.g. an invite link like https://t.me/+AbCdEf12345).
TELEGRAM_CHANNEL_LINK=
ADMIN_TELEGRAM_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/german_bot
# For local dev without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./german_bot.db

# LLM (primary provider)
# codecraftapi.com is OpenAI-compatible (Bearer auth, /chat/completions format),
# so it reuses the same provider code -- just set LLM_PROVIDER=codecraft.
# TODO: confirm the exact model name from https://codecraftapi.com/models or your
# account dashboard before going live -- gpt-4o-mini is NOT confirmed to exist there.
LLM_PROVIDER=codecraft
LLM_API_KEY=your-codecraftapi-key
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL is optional for provider=codecraft (defaults to https://codecraftapi.com/v1)
LLM_BASE_URL=

# LLM (backup/fallback provider) -- kept as the original OpenAI setup.
# When enabled, if the primary provider above fails, the bot automatically
# retries the same request against this one before giving up.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_BASE_URL=

# Scheduling
TIMEZONE=Asia/Tashkent
POST_TIMES=08:00,12:00,16:00,20:00,22:00

# Content strategy
PROMOTIONAL_POST_RATIO=0.10
DUPLICATE_SIMILARITY_THRESHOLD=0.80
MAX_GENERATION_ATTEMPTS=3
DEFAULT_CEFR_LEVEL=Mixed

# News (optional)
NEWS_ENABLED=false
NEWS_API_KEY=

# Marketing
GERMAN_CLASSES_CONTACT=@your_contact

# Health check server
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8080

# Logging
LOG_LEVEL=INFO
